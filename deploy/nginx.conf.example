# Contoh konfigurasi Nginx untuk portfolio Laravel.
# Salin ke /etc/nginx/sites-available/portfolio, sesuaikan placeholder,
# lalu: ln -s /etc/nginx/sites-available/portfolio /etc/nginx/sites-enabled/
#       nginx -t && systemctl reload nginx
server {
    listen 80;
    listen [::]:80;
    server_name <DOMAIN_ANDA> www.<DOMAIN_ANDA>;
    root /var/www/portfolio/public;

    index index.php;
    charset utf-8;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ ^/index\.php(/|$) {
        # Sesuaikan versi PHP-FPM yang terpasang (cek: ls /run/php/)
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    # Tolak akses ke file tersembunyi (.env, .git, dll.)
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
